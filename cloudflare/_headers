# Copied into frontend/dist by cloudflare/build.mjs. Workers Static Assets apply these to the
# files of the app; the same four security headers are added by cloudflare/worker.js to what the
# Worker answers itself (/api, the root, redirects). Mirrors web/nginx.conf.template.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'

# Vite's chunks carry a content hash in their names, so they never change under one URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# nginx gives every image 30 days, the two app icons included.
/icon-180.png
  Cache-Control: public, max-age=2592000, immutable
/icon-512.png
  Cache-Control: public, max-age=2592000, immutable
